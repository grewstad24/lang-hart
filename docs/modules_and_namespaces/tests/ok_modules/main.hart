use std::*
use mylib::math

func main() -> s32 {
    @ctx := default_context
    # Global qualified access without `use`: mylib::prelude::cube
    # Short module binding via `use`: math::square
    # Direct submodule brought in non-recursively by `use std::*`: libc::malloc / libc::free
    # Private `func helper()` and `const secret` in both `mylib::math` and `mylib::prelude` must not collide
    p := libc::malloc(4 as usize)
    libc::free(p)
    total := math::square(6) + mylib::prelude::cube(2) + math::mathTagged() + mylib::prelude::preludeTagged()
    # 36 + 8 + 110 + 220 = 374
    return if {
        total = 374 => 0
        else => 1
    }
}
