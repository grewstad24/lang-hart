extern fn printf( ptr :: *u8, ...) -> s32

type Printable := String | Integer | :nl | :t | bool | []Printable | Record

fn print_string(s :: []u8)
    printf("%s".ptr, s.ptr)
end

fn pr_nl()
    printf("\n".ptr)
end

fn pr_tab()
    printf("\t".ptr)
end

fn print_int(num :: Integer)
    match num with z
        s32 => printf("%d".ptr, z)
        s16 => printf("%d".ptr, z as s32)
        s64 => printf("%lld".ptr, z)
        u16 => printf("%u".ptr, z as u32)
        u32 => printf("%u".ptr, z)
        u64 => printf("%llu".ptr, z)
    over
end

fn printa(arr :: []Printable)
    var i := 0
    dotimes arr.len => {
        print(arr[i])
        i := i + 1
    }
end

fn print(x :: Printable)
    match x with z
        String      => print_string(z)
        Integer     => print_int(z)
        :nl         => pr_nl()
        :t          => pr_tab()
        []Printable => printa(z)
        bool => if
            z = true => print("true")
            else     => print("false")
        end
        Record      => printr(z)
    over
end

fn println(x :: Printable)
    print(x)
    pr_nl()
end

fn printr(r :: Record)
    var i := 0
    let header := r.*
    let keys := header.key
    let values := header.val

    dotimes header.len => {
        [ keys[i], " : " ] ..print()

        match values[i] with z
            Record => [:nl, "(", :nl, z, ")", :nl] ..print()
            _      => [z, :nl] ..print()
        over

        i := i + 1
    }
end
