@extern printf
( ptr :: *u8 )++ to s32

@val print_string
do ( s :: []u8 )
        printf ("%s".ptr, s.ptr)
done

@type Printable
String | Integer | :nl | :t

@val print_int
do ( num :: Integer )
        match num with z
                s32 => printf ("%d"     .ptr, z)
                s16 => printf ("%d"     .ptr, z as s32)
                s64 => printf ("%lld"   .ptr, z)
                u16 => printf ("%u"     .ptr, z as u32)
                u32 => printf ("%u"     .ptr, z)
                u64 => printf ("%llu"   .ptr, z)
        over
done

@val pr_nl
do
        printf ("\n".ptr)
done

@val pr_tab
do
        printf ("\t".ptr)
done

@val printa
do ( arr :: []Printable )
        var x :: s32
        0-> x

        dotimes arr.len => {
                print(arr[x])
                x + 1 -> x
        }
done

@val print
do ( x :: Printable | []Printable )
        match x with z
                String          => print_string(z)
                Integer         => print_int(z)
                :nl             => pr_nl()
                :t              => pr_tab()
                []Printable     => printa(z)
        over
done

@val println
do ( x :: Printable )
        print(x)
        pr_nl()
done

@val printaln
do ( x :: []Printable )
        printa(x)
        pr_nl()
done
