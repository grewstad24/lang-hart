decl mod print {
      export {
            { print, println } to .print,
            { printf } to .print.raw_printf
      }
}


extern fn printf( ptr: *u8, ...) -> s32


type Printable := String | Integer | :nl | :t | bool | []Printable | Record


fn print( x: Printable ) -> :none {
      match x using z {
            String => print_string(z)
            Integer => print_int(z)
            :nl => pr_nl()
            :t => pr_tab()
            []Printable => printa(z)
            bool => switch z {
                  true => print("true")
                  false => print("false")
            }
            Record => printr(z)
      }
}


fn println( x: Printable ) -> :none {
      print(x)
      pr_nl()
}
