decl mod print {
      export {
            { print, println } to .print,
            { printf } to .print.raw_printf
      }
}


extern fn printf( ptr: *u8, ...) -> s32


type Printable := String | Integer | :nl | :t | bool | []Printable


fn print( x: Printable ) -> :none {
      match x using z {
            String => print_string(z)
            SignedInteger => print_sint(z)
            UnsignedInteger => print_uint(z)
            :nl => pr_nl()
            :t => pr_tab()
            []Printable => printa(z)
            bool => switch z {
                  true => print("true")
                  else => print("false")
            }
      }
}


fn println( x: Printable ) -> :none {
      print(x)
      pr_nl()
}
