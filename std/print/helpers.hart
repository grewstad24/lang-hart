mod print


def print_string(s) {
      printf("%s".ptr, s.ptr)
}


def pr_nl() {
      printf("\n".ptr)
}


def pr_tab() {
      printf("\t".ptr)
}


def print_sint(num) {
      printf("%lld".ptr, num as s64)
}


def print_uint(num) {
      printf("%llu".ptr, num as u64)
}


def printa(arr) {
      repeat arr.len using i {
            print(arr[i])
      }
      return :none
}
