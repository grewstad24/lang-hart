mod print


def printString(s) {
      printf("%s".ptr, s.ptr)
}


def prNl() {
      printf("\n".ptr)
}


def prTab() {
      printf("\t".ptr)
}


def printSint(num) {
      printf("%lld".ptr, num as s64)
}


def printUint(num) {
      printf("%llu".ptr, num as u64)
}


def printa(arr) {
      repeat arr.len using i {
            print(arr[i])
      }
      return :none
}
