decl mod print {
      export {
            { print, println } to .print,
            { printf } to .print.raw_printf
      }
}


extern func printf( ptr: *u8, ...) -> s32


type Printable :=
      String
      | Integer
      | :nl
      | :t
      | ( :softTab, Integer )
      | Bool
      | Slice <Printable>


def print( x ) {
      match x using z {
            String => print_string(z)
            SignedInteger => print_sint(z)
            UnsignedInteger => print_uint(z)
            :nl => pr_nl()
            :t => pr_tab()
            ( :softTab, Integer ) => repeat (z.1 as usize) { print(" ") }
            Slice <Printable> => printa(z)
            Bool => match z {
                  :true => print("true")
                  :false => print("false")
            }
      }
}


def println( x ) {
      print(x)
      pr_nl()
}
