decl mod print {
      export {
            { print, println, printString, printSint, printUint, prNl, prTab, printa } to .print,
            { printf } to .print.raw_printf
      }
}


extern func printf( ptr: *u8, ...) -> s32


type Printable :=
      String
      | Integer
      | :nl
      | :t
      | ( :softTab, Integer )
      | Bool
      | Slice <Printable>


def print( x ) {
      match x using z {
            String => printString(z)
            SignedInteger => printSint(z)
            UnsignedInteger => printUint(z)
            :nl => prNl()
            :t => prTab()
            ( :softTab, Integer ) => repeat (z.1 as usize) { print(" ") }
            Slice <Printable> => printa(z)
            Bool => match z {
                  :true => print("true")
                  :false => print("false")
            }
      }
}


def println( x ) {
      print([x, :nl])
}
