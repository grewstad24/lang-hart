mod print


fn print_string( s: []u8 ) -> :none {
      printf("%s".ptr, s.ptr)
}


fn pr_nl() -> :none {
      printf("\n".ptr)
}


fn pr_tab() -> :none {
      printf("\t".ptr)
}


fn print_sint( num: SignedInteger ) -> :none {
      printf("%lld".ptr, num as s64)
}


fn print_uint( num: UnsignedInteger ) -> :none {
      printf("%llu".ptr, num as u64)
}


fn printa( arr: []Printable ) -> :none {
      repeat arr.len using i {
            print(arr[i])
      }
}
