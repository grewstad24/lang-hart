mod io

type File := {
      fd: s32
}

const stdin := { fd: 0 }
const stdout := { fd: 1 }
const stderr := { fd: 2 }

def to_c_str(path) {
      return match path using p {
            String => p.ptr
            *u8 => p
            else => p.ptr
      }
}

def open_file(path) { { fd: open(to_c_str(path), oReadOnly, 0) } }

def create_file(path) { { fd: open(to_c_str(path), oCreateWrite, defaultFileMode) } }

def append_file(path) { { fd: open(to_c_str(path), oCreateAppend, defaultFileMode) } }

def is_ok(file) { file.fd >= 0 }

def is_err(file) { file.fd < 0 }

def close_file(file) { close(file.fd) }

def copy_to(src, dst) {
      return match dst using d {
            File => copy_stream(src.fd, d.fd, defaultBufferSize)
            Integer => copy_stream(src.fd, d as s32, defaultBufferSize)
      }
}

def copy(src, dst) {
      return match src using s {
            File => s.copy_to(dst)
            Integer => {
                  mut f := { fd: s as s32 }
                  yield f.copy_to(dst)
            }
      }
}

def stream(file, chunk_size, callback) {
      stream_fd(file.fd, chunk_size, callback)
}

def write_data(file, data) {
      mut remaining := data.len
      mut curr_ptr := data.ptr
      repeat while remaining > 0 {
            mut n := write(file.fd, curr_ptr, remaining)
            if {
                  n > 0 => {
                        mut written := n as usize
                        curr_ptr := (curr_ptr as usize + written) as *u8
                        remaining -= written
                  }
                  else => return :error
            }
      }
      return :ok
}

def read_all(file) {
      mut size := lseek(file.fd, 0, seekEnd)
      lseek(file.fd, 0, seekSet)
      if {
            size < 0 => return (:error, :seek_failed)
            else => :none
      }
      mut u_size := size as usize
      mut buf := alloc(u_size + 1)
      mut total_read: usize := 0
      mut curr_ptr := buf as *u8
      repeat while total_read < u_size {
            mut n := read(file.fd, curr_ptr, u_size - total_read)
            if {
                  n > 0 => {
                        mut read_bytes := n as usize
                        curr_ptr := (curr_ptr as usize + read_bytes) as *u8
                        total_read += read_bytes
                  }
                  else => break
            }
      }
      return { ptr: buf as *u8, len: total_read }
}

def read_file(path) {
      mut file := open_file(path)
      if {
            file.is_err() => return (:error, :open_failed)
            else => :none
      }
      defer file.close_file()
      return file.read_all()
}

def write_file(path, data) {
      mut file := create_file(path)
      if {
            file.is_err() => return (:error, :open_failed)
            else => :none
      }
      defer file.close_file()
      return file.write_data(data)
}

def append_to_file(path, data) {
      mut file := append_file(path)
      if {
            file.is_err() => return (:error, :open_failed)
            else => :none
      }
      defer file.close_file()
      return file.write_data(data)
}
