mod io

type File := {
      fd: s32
}

def to_c_str(path) {
      return match path using p {
            String => p.ptr
            *u8 => p
            else => p.ptr
      }
}

def open_file(path) {
      return { fd: open(to_c_str(path), 0, 0) }
}

def create_file(path) {
      return { fd: open(to_c_str(path), 577, 420) }
}

def append_file(path) {
      return { fd: open(to_c_str(path), 1089, 420) }
}

def stdin() {
      return { fd: 0 }
}

def stdout() {{ fd: 1 }}

def stderr() {{ fd: 2 }}

def is_ok(file) { file.fd >= 0 }

def is_err(file) {
      return file.fd < 0
}

def close_file(file) {
      return close(file.fd)
}

def copy_to(src, dst) {
      match dst using d {
            File => copy_stream(src.fd, d.fd, 8192 as usize)
            s32 => copy_stream(src.fd, d, 8192 as usize)
      }
}

def copy(src, dst) {
      match src using s {
            File => s.copy_to(dst)
            s32 => {
                  mut f := { fd: s }
                  f.copy_to(dst)
            }
      }
}

def stream(file, chunk_size, callback) {
      stream_fd(file.fd, chunk_size, callback)
}

def write_all_loop(fd, ptr, remaining) {
      return if {
            remaining > 0 as usize => {
                  mut n := write(fd, ptr, remaining)
                  if {
                        n > 0 as s64 => {
                              mut written := n as usize
                              mut next_ptr := (ptr as usize + written) as *u8
                              return write_all_loop(fd, next_ptr, remaining - written)
                        }
                        else => return :error
                  }
            }
            else => :ok
      }
}

def write_data(file, data) {
      return write_all_loop(file.fd, data.ptr, data.len)
}

def read_all(file) {
      mut size := lseek(file.fd, 0 as s64, 2)
      lseek(file.fd, 0 as s64, 0)
      return if {
            size < 0 as s64 => (:error, :seek_failed)
            else => {
                  mut u_size := size as usize
                  mut buf := alloc(u_size + 1 as usize)
                  read(file.fd, buf as *u8, u_size)
                  return { ptr: buf as *u8, len: u_size }
            }
      }
}

def read_file(path) {
      mut file := open_file(path)
      return if {
            file.is_err() => (:error, :open_failed)
            else => {
                  mut data := file.read_all()
                  file.close_file()
                  return data
            }
      }
}

def write_file(path, data) {
      mut file := create_file(path)
      return if {
            file.is_err() => (:error, :open_failed)
            else => {
                  file.write_data(data)
                  file.close_file()
                  return :ok
            }
      }
}

def append_to_file(path, data) {
      mut file := append_file(path)
      return if {
            file.is_err() => (:error, :open_failed)
            else => {
                  file.write_data(data)
                  file.close_file()
                  return :ok
            }
      }
}
