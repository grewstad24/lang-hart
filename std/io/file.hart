mod io

type File := {
      fd: s32
}

const stdin := { fd: 0 }
const stdout := { fd: 1 }
const stderr := { fd: 2 }

def toCStr(path) {
      return match path using p {
            String => p.ptr
            *u8 => p
            else => p.ptr
      }
}

def openFile(path) { { fd: open(toCStr(path), o_read_only, 0) } }

def createFile(path) { { fd: open(toCStr(path), o_create_write, default_file_mode) } }

def appendFile(path) { { fd: open(toCStr(path), o_create_append, default_file_mode) } }

def isOk(file) { file.fd >= 0 }

def isErr(file) { file.fd < 0 }

def closeFile(file) { close(file.fd) }

def copyTo(src, dst) {
      return match dst using d {
            File => copyStream(src.fd, d.fd, default_buffer_size)
            Integer => copyStream(src.fd, d as s32, default_buffer_size)
      }
}

def copy(src, dst) {
      return match src using s {
            File => s.copyTo(dst)
            Integer => {
                  mut f := { fd: s as s32 }
                  yield f.copyTo(dst)
            }
      }
}

def stream(file, chunk_size, callback) {
      streamFd(file.fd, chunk_size, callback)
}

def writeData(file, data) {
      mut remaining := data.len
      mut curr_ptr := data.ptr
      repeat while remaining > 0 {
            mut n := write(file.fd, curr_ptr, remaining)
            if {
                  n > 0 => {
                        mut written := n as usize
                        curr_ptr := (curr_ptr as usize + written) as *u8
                        remaining -= written
                  }
                  else => return :error
            }
      }
      return :ok
}

def readAll(file) {
      mut size := lseek(file.fd, 0, seek_end)
      lseek(file.fd, 0, seek_set)
      if {
            size < 0 => return (:error, :seek_failed)
            else => :none
      }
      mut u_size := size as usize
      mut buf := alloc(u_size + 1)
      mut total_read: usize := 0
      mut curr_ptr := buf as *u8
      repeat while total_read < u_size {
            mut n := read(file.fd, curr_ptr, u_size - total_read)
            if {
                  n > 0 => {
                        mut read_bytes := n as usize
                        curr_ptr := (curr_ptr as usize + read_bytes) as *u8
                        total_read += read_bytes
                  }
                  else => break
            }
      }
      return { ptr: buf as *u8, len: total_read }
}

def readFile(path) {
      mut file := openFile(path)
      if {
            file.isErr() => return (:error, :open_failed)
            else => :none
      }
      defer file.closeFile()
      return file.readAll()
}

def writeFile(path, data) {
      mut file := createFile(path)
      if {
            file.isErr() => return (:error, :open_failed)
            else => :none
      }
      defer file.closeFile()
      return file.writeData(data)
}

def appendToFile(path, data) {
      mut file := appendFile(path)
      if {
            file.isErr() => return (:error, :open_failed)
            else => :none
      }
      defer file.closeFile()
      return file.writeData(data)
}
