decl mod io {
      export {
            File,
            openFile, createFile, appendFile,
            stdin, stdout, stderr,
            copy, copyTo, stream, copyStream, streamFd,
            readFile, writeFile, appendToFile,
            isOk, isErr, closeFile, writeData, readAll,
            open, close, read, write, lseek,
            default_buffer_size
