mod io

# Standard file descriptor numbers
const stdin_fileno := 0
const stdout_fileno := 1
const stderr_fileno := 2

# open() flags
const o_rdonly := 0
const o_read_only := 0
const o_wronly := 1
const o_write_only := 1
const o_rdwr := 2
const o_read_write := 2
const o_creat := 64
const o_create := 64
const o_trunc := 512
const o_append := 1024

# Combined open() flags for creation and appending
# o_write_only | o_create | o_trunc (1 + 64 + 512 = 577)
const o_create_write := 577
# o_write_only | o_create | o_append (1 + 64 + 1024 = 1089)
const o_create_append := 1089

# Standard file permissions (0644 octal = 420 decimal: rw-r--r--)
const default_file_mode := 420

# lseek() whence values
const seek_set := 0
const seek_cur := 1
const seek_end := 2

# Default buffer size for stream operations
const default_buffer_size := 8192 as usize

extern func open(path: *u8, flags: s32, mode: s32) -> s32
extern func close(fd: s32) -> s32
extern func read(fd: s32, buf: *u8, bytes: usize) -> s64
extern func write(fd: s32, buf: *u8, bytes: usize) -> s64
extern func lseek(fd: s32, offset: s64, whence: s32) -> s64
