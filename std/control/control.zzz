@val times
do (count :: s32, fn :: Fn{()})
        doif
                count > 0 => {
                        fn()
                        times(count - 1, fn)
                }
        end
done

@val repeat
do (fn :: Fn{()}, count :: s32)
        doif
                count > 0 => {
                        fn()
                        repeat(fn, count - 1)
                }
        end
done


@val loop
do (fn :: Fn{()})
        fn()
        loop(fn)
done
