mod pprint


const style_red := "\u{1B}[31m"
const style_bright_red := "\u{1B}[91m"
const style_green := "\u{1B}[32m"
const style_yellow := "\u{1B}[33m"
const style_cyan := "\u{1B}[36m"
const style_blue := "\u{1B}[34m"
const style_magenta := "\u{1B}[35m"

const style_italic := "\u{1B}[3m"
const style_bold := "\u{1B}[1m"
const style_dim := "\u{1B}[2m"
const style_reset := "\u{1B}[0m"


def pprintBool(z) {
      match z {
            :true => [ style_green, "✔ true", style_reset ].print()
            :false => [ style_red, "✘ false", style_reset ].print()
      }
}

def pprintAtom(z, err) {
      match err {
            :false => [ style_magenta, style_italic, style_bold, z.str, style_reset ].print()
            :true => [ style_bright_red, style_italic, style_bold, z.str, style_reset ].print()
      }
}

def pprintString(z, err) {
      match err {
            :false => [ style_yellow, "'", z, "'", style_reset ].print()
            :true => [ style_bright_red, "'", z, "'", style_reset ].print()
      }
}

def pprintInteger(z) {
      [ style_cyan, z, style_reset ].print()
}

def pprintVoidance(z, indent_level) {
      match z using v {
            :none => [ style_dim, "∅ none", style_reset ].print()
            :error => [ style_bright_red, "‼ error", style_reset ].print()
            ErrorAndReason => {
                  [ style_bright_red, "‼ error ", style_reset].print()
                  internalPprint(v.1, indent_level + 1, :true)
            }
      }
}

def pprintArray( z, indent_level, err ) {
      switch indent_level {
            0 => :none
            else => print(:nl)
      }
      repeat z.len using idx {
            elem := z[idx]
            switch indent_level {
                  0 => :none
                  else => {
                        repeat indent_level { print(( :softTab, 6 )) }
                        match err {
                              :false => print("• ")
                              else => print([style_bright_red, "• ", style_reset])
                        }
                  }
            }

            match elem using inner {
                  Slice <Generic> => {
                        print("↘")
                        pprintArray(inner, indent_level + 1, err)
                  }
                  Record => {
                        pprintRecord(inner, indent_level + 1, err)
                  }
                  else => {
                        internalPprint(inner, indent_level, err)
                  }
            }
            if {
                  idx < z.len - 1 => print(:nl)
                  else => :none
            }
      }
}

def pprintRecord( item, indent_level, err ) {
      switch indent_level {
            0 => :none
            else => print(:nl)
      }
      rec := item
      repeat rec.*.len using i {
            repeat indent_level { print(( :softTab, 6 )) }
            k := rec.*.key[i]
            v := rec.*.val[i]
            match err {
                  :true => print([style_bright_red, k, style_reset, style_blue, style_bold, ": ", style_reset])
                  :false => print([k, style_blue, style_bold, ": ", style_reset])
            }
            match v using inner {
                  Record => pprintRecord(inner, indent_level + 1, err)
                  Slice <Generic> => pprintArray(inner, indent_level + 1, err)
                  else => {
                        internalPprint(v, indent_level, err)
                  }
            }
            if {
                  i < rec.*.len - 1 => print(:nl)
                  else => :none
            }
      }
}
