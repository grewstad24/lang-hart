mod pprint


const styleRed := "\u{1B}[31m"
const styleBrightRed := "\u{1B}[91m"
const styleGreen := "\u{1B}[32m"
const styleYellow := "\u{1B}[33m"
const styleCyan := "\u{1B}[36m"
const styleBlue := "\u{1B}[34m"
const styleMagenta := "\u{1B}[35m"

const styleItalic := "\u{1B}[3m"
const styleBold := "\u{1B}[1m"
const styleDim := "\u{1B}[2m"
const styleReset := "\u{1B}[0m"


def pprint_bool(z) {
      match z {
            :true => [ styleGreen, "✔ true", styleReset ].print()
            :false => [ styleRed, "✘ false", styleReset ].print()
      }
}

def pprint_atom(z, err) {
      match err {
            :false => [ styleMagenta, styleItalic, styleBold, z.str, styleReset ].print()
            :true => [ styleBrightRed, styleItalic, styleBold, z.str, styleReset ].print()
      }
}

def pprint_string(z) {
      [ styleYellow, "'", z, "'", styleReset ].print()
}

def pprint_integer(z) {
      [ styleCyan, z, styleReset ].print()
}

def pprint_voidance(z, indent_level) {
      match z using v {
            :none => [ styleDim, "∅ none", styleReset ].print()
            :error => [ styleBrightRed, "‼ error", styleReset ].print()
            ErrorAndReason => {
                  [ styleBrightRed, "‼ error ", styleReset].print()
                  internal_pprint(v.1, indent_level + 1, :true)
            }
      }
}

def pprint_array( z, indent_level, err ) {
      switch indent_level {
            0 => :none
            else => print(:nl)
      }
      repeat for z using elem {
            switch indent_level {
                  0 => :none
                  else => {
                        repeat indent_level { print(( :softTab, 6 )) }
                        match err {
                              :false => print("• ")
                              else => print([styleBrightRed, "• ", styleReset])
                        }
                  }
            }

            match elem using inner {
                  Slice <Generic> => {
                        print("↘")
                        pprint_array(inner, indent_level + 1, err)
                  }
                  Record => {
                        pprint_record(inner, indent_level + 1, err)
                  }
                  else => {
                        internal_pprint(inner, indent_level, err)
                        print(:nl)
                  }
            }
      }
}

def pprint_record( item, indent_level, err ) {
      switch indent_level {
            0 => :none
            else => print(:nl)
      }
      rec := item
      repeat rec.*.len using i {
            repeat indent_level { print(( :softTab, 6 )) }
            k := rec.*.key[i]
            v := rec.*.val[i]
            match err {
                  :true => print([styleBrightRed, k, styleReset])
                  :false => print(k)
            }
            print([ styleBlue, styleBold, ": ", styleReset ])
            match v using inner {
                  Record => pprint_record(inner, indent_level + 1, err)
                  Slice <Generic> => pprint_array(inner, indent_level + 1, err)
                  else => {
                        internal_pprint(v, indent_level, err)
                        print(:nl)
                  }
            }
      }
}
