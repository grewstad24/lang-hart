decl mod pprint {
      export { pprint } to .print.pretty
      import { .print }
}

def pprint( item ) {
      internal_pprint(item, 0, :false)
}

def internal_pprint( item, indent_level, err ) {
      match item using z {
            Bool => pprint_bool(z)
            Integer => pprint_integer(z)
            String => pprint_string(z)
            Atom => pprint_atom(z, err)
            Slice<Generic> => pprint_array(z, indent_level, err)
            Record => pprint_record(z, indent_level, err)
            *Generic => pprint(z.*)
            Voidance => pprint_voidance(z, indent_level)
      }
}
