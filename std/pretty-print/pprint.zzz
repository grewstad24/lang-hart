decl mod pprint {
      export { pprint } to .print.pretty
      import { .print }
}

fn pprint( item: Generic ) -> :none {
      internal_pprint(item, 0 as u16)
}

fn internal_pprint( item: Generic, indent_level: u16 ) -> :none {
      match item using z {
            bool => pprint_bool(z)
            Integer => pprint_integer(z)
            String => pprint_string(z)
            []Generic => pprint_array(z, indent_level)
            else => :none
      }
}
