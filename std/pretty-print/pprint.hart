decl mod pprint {
      export { pprint } to .print.pretty
      import { .print }
}

def pprint( item ) {
      internalPprint(item, 0, :false)
      print(:nl)
}

def internalPprint( item, indent_level, err ) {
      match item using z {
            Bool => pprintBool(z)
            Integer => pprintInteger(z)
            String => pprintString(z)
            Atom => pprintAtom(z, err)
            Slice<Generic> => pprintArray(z, indent_level, err)
            Record => pprintRecord(z, indent_level, err)
            *Generic => pprint(z.*)
            Voidance => pprintVoidance(z, indent_level)
      }
}
