decl mod pprint {
      export { pprint, pprintln, pprintErr, pprintlnErr, style_yellow, style_bright_red, style_reset } to .print.pretty
      import { .print }
}

def pprint( item ) {
      internalPprint(item, 0, :false)
}

def pprintln( item ) {
      pprint(item)
      print(:nl)
}

def pprintErr( item ) {
      internalPprint(item, 0, :true)
}

def pprintlnErr( item ) {
      pprintErr(item)
      print(:nl)
}

def internalPprint( item, indent_level, err ) {
      match item using z {
            Bool => pprintBool(z)
            Integer => pprintInteger(z)
            String => pprintString(z, err)
            Atom => pprintAtom(z, err)
            Slice<Generic> => pprintArray(z, indent_level, err)
            Record => pprintRecord(z, indent_level, err)
            *Generic => pprint(z.*)
            Voidance => pprintVoidance(z, indent_level)
      }
}
