export {
      { alloc, heap_new, alloc_resizeable_array, ResizeableArray } to .heap,
      { malloc, free, calloc } to .heap.raw_libc
}


extern fn malloc( size: usize ) -> *opaque


extern fn calloc( num: usize, size: usize ) -> *opaque


meta fn contiguous_alloc( num: usize, T: type ) -> []T { @slice (
      ptr := calloc(num, @sizeOf T)
      len := num
)}


extern fn free( ptr: *opaque ) -> :none


meta fn alloc( T: type ) -> *T
{ malloc( @sizeOf T ) as *T }


meta fn heap_new( T: type, val: T ) -> *T {
      let ptr := alloc(type T)
      ptr.* := val
      return ptr
}


meta type ResizeableArray<T> := (
      arr: []T
      capacity: usize
)


meta fn alloc_resizeable_array( T: type, len: usize ) ->
ResizeableArray<T> | :zeroLengthError
{
      return if {
            len = 0 as usize => :zeroLengthError
            else => (
                  arr := contiguous_alloc(len * 2 as usize, type T)
                  capacity := len * 2 as usize
            )
      }
}
