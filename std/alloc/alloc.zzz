decl mod alloc {
      export {
            { alloc, heap_new, resize_alloc, alloc_vector, Vector, resize_vector } to .heap,
            { malloc, free, realloc } to .heap.raw_libc
      }
}


extern fn malloc( size: usize ) -> *mut opaque


meta fn contiguous_alloc( num: usize, T: type ) -> []T { @slice (
      ptr := malloc(num * @sizeOf T) as *T
      len := num
)}


extern fn free( ptr: *opaque ) -> :none


extern fn realloc( ptr: *opaque, new_size: usize ) -> *mut opaque


meta fn resize_alloc( T: type, ptr: *T, new_size: usize ) -> *T
{ realloc(ptr, new_size) as *T }


meta fn alloc( T: type ) -> *mut T
{ malloc( @sizeOf T ) as *mut T }


meta fn heap_new( T: type, val: T ) -> *mut T {
      let ptr := alloc(type T)
      ptr.* := val
      return ptr
}
