decl mod alloc {
      export {
            { heap_new, free } to .heap,
      }
}


extern func malloc( size: usize ) -> *mut opaque


meta func contiguous_alloc(num: usize, T: type) -> Slice <T> {
      return {
            ptr := malloc(num * @sizeOf T) as *T
            len := num
      }
}


extern func free(ptr: *opaque) -> :none


extern func realloc(ptr: *opaque, new_size: usize) -> *mut opaque


meta func resize_alloc(T: type, ptr: *T, new_size: usize) -> *T
{ realloc(ptr, new_size) as *T }


meta func alloc(T: type) -> *mut T
{ malloc( @sizeOf T ) as *mut T }


def heap_new(a) {
      ptr := alloc(@typeOf a)
      ptr.* := a
      return ptr
}
