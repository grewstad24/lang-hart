mod std

const style_red := "\u{1B}[31m"
const style_bright_red := "\u{1B}[91m"
const style_green := "\u{1B}[32m"
const style_yellow := "\u{1B}[33m"
const style_cyan := "\u{1B}[36m"
const style_blue := "\u{1B}[34m"
const style_magenta := "\u{1B}[35m"

const style_italic := "\u{1B}[3m"
const style_bold := "\u{1B}[1m"
const style_dim := "\u{1B}[2m"
const style_reset := "\u{1B}[0m"

def pprintBool(z) {
      match z {
            :true => return print([ style_green, "✔ true", style_reset ])
            :false => return print([ style_red, "✘ false", style_reset ])
      }
}

def pprintString(z) { print([ style_yellow, "'", z, "'", style_reset ]) }

def pprintInteger(z) { print([ style_cyan, z, style_reset ]) }

def pprintVoidance(z, indent_level) -> :none | IoError {
      match z using v {
            :none => return print([ style_dim, "∅ none", style_reset ])
            :error => return print([ style_bright_red, "‼ error", style_reset ])
            ErrorAndReason => {
                  match print([ style_bright_red, "‼ error ", style_reset ]) using err {
                        IoError => return err
                        else => :none
                  }
                  return internalPprint(v.1, indent_level + 1)
            }
      }
}

def pprintArray(z, indent_level) -> :none | IoError {
      switch indent_level {
            0 => :none
            else => match print(:nl) using err {
                  IoError => return err
                  else => :none
            }
      }
      repeat z.len using idx {
            elem := z[idx]
            switch indent_level {
                  0 => :none
                  else => {
                        repeat indent_level {
                              match print(:t) using err {
                                    IoError => return err
                                    else => :none
                              }
                        }
                        match print("• ") using err {
                              IoError => return err
                              else => :none
                        }
                  }
            }

            match elem using inner {
                  Slice <Generic> => {
                        match print("↘") using err {
                              IoError => return err
                              else => :none
                        }
                        match pprintArray(inner, indent_level + 1) using err {
                              IoError => return err
                              else => :none
                        }
                  }
                  Record => {
                        match pprintRecord(inner, indent_level + 1) using err {
                              IoError => return err
                              else => :none
                        }
                  }
                  else => {
                        match internalPprint(inner, indent_level) using err {
                              IoError => return err
                              else => :none
                        }
                  }
            }
            if {
                  idx < z.len - 1 => match print(:nl) using err {
                        IoError => return err
                        else => :none
                  }
                  else => :none
            }
      }
      return :none
}

def pprintRecord(item, indent_level) -> :none | IoError {
      switch indent_level {
            0 => :none
            else => match print(:nl) using err {
                  IoError => return err
                  else => :none
            }
      }
      rec := item
      repeat rec.*.len using i {
            repeat indent_level {
                  match print(:t) using err {
                        IoError => return err
                        else => :none
                  }
            }
            k := rec.*.key[i]
            v := rec.*.val[i]
            match print([k, style_blue, style_bold, ": ", style_reset]) using err {
                  IoError => return err
                  else => :none
            }
            match v using inner {
                  Record => match pprintRecord(inner, indent_level + 1) using err {
                        IoError => return err
                        else => :none
                  }
                  Slice <Generic> => match pprintArray(inner, indent_level + 1) using err {
                        IoError => return err
                        else => :none
                  }
                  else => {
                        match internalPprint(v, indent_level) using err {
                              IoError => return err
                              else => :none
                        }
                  }
            }
            if {
                  i < rec.*.len - 1 => match print(:nl) using err {
                        IoError => return err
                        else => :none
                  }
                  else => :none
            }
      }
      return :none
}

def internalPprint(item, indent_level) -> :none | IoError {
      match item using z {
            Bool => return pprintBool(z)
            Integer => return pprintInteger(z)
            String => return pprintString(z)
            Slice<Generic> => return pprintArray(z, indent_level)
            Record => return pprintRecord(z, indent_level)
            *Generic => return internalPprint(z.*, indent_level)
            Voidance => return pprintVoidance(z, indent_level)
      }
}

pub func stdPrinter(ctx: *Context, item: Generic) -> IoError | :none {
      @ctx := ctx.*
      ret := internalPprint(item, 0)
      match ret {
            IoError => return ret
            else => return print(:nl)
      }
}

def hartPrintIndent(indent_level) -> :none | IoError {
      repeat indent_level {
            match print(:t) using err {
                  IoError => return err
                  else => :none
            }
      }
      return :none
}

def hartPrintArray(z, indent_level) -> :none | IoError {
      if {
            z.len = (0 as usize) => return print("[]")
            else => :none
      }
      match print("[\n") using err {
            IoError => return err
            else => :none
      }
      repeat z.len using idx {
            match hartPrintIndent(indent_level + 1) using err {
                  IoError => return err
                  else => :none
            }
            match internalHartPrint(z[idx], indent_level + 1) using err {
                  IoError => return err
                  else => :none
            }
            match print(:nl) using err {
                  IoError => return err
                  else => :none
            }
      }
      match hartPrintIndent(indent_level) using err {
            IoError => return err
            else => :none
      }
      return print("]")
}

def hartPrintRecord(rec, indent_level) -> :none | IoError {
      if {
            rec.*.len = (0 as usize) => return print("{}")
            else => :none
      }
      match print("{\n") using err {
            IoError => return err
            else => :none
      }
      repeat rec.*.len using i {
            match hartPrintIndent(indent_level + 1) using err {
                  IoError => return err
                  else => :none
            }
            match print([rec.*.key[i], ": "]) using err {
                  IoError => return err
                  else => :none
            }
            match internalHartPrint(rec.*.val[i], indent_level + 1) using err {
                  IoError => return err
                  else => :none
            }
            match print(:nl) using err {
                  IoError => return err
                  else => :none
            }
      }
      match hartPrintIndent(indent_level) using err {
            IoError => return err
            else => :none
      }
      return print("}")
}

def hartPrintVoidance(z, indent_level) -> :none | IoError {
      match z using v {
            :none => return print(":none")
            :error => return print(":error")
            ErrorAndReason => {
                  match print("(:error, ") using err {
                        IoError => return err
                        else => :none
                  }
                  match internalHartPrint(v.1, indent_level) using err {
                        IoError => return err
                        else => :none
                  }
                  return print(")")
            }
      }
}

def internalHartPrint(item, indent_level) -> :none | IoError {
      match item using z {
            Bool => match z {
                  :true => return print(":true")
                  :false => return print(":false")
            }
            Integer => return print(z)
            String => return print(["\"", z, "\""])
            Slice<Generic> => return hartPrintArray(z, indent_level)
            Record => return hartPrintRecord(z, indent_level)
            *Generic => return internalHartPrint(z.*, indent_level)
            Voidance => return hartPrintVoidance(z, indent_level)
      }
}

pub func debugPrinter(ctx: *Context, item: Generic) -> IoError | :none {
      @ctx := ctx.*
      ret := internalHartPrint(item, 0)
      match ret {
            IoError => return ret
            else => return print(:nl)
      }
}

pub def pprint(item) { @ctx.printer(@ctx.&, item) }
