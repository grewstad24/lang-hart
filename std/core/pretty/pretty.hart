mod std

const style_red := "\u{1B}[31m"
const style_bright_red := "\u{1B}[91m"
const style_green := "\u{1B}[32m"
const style_yellow := "\u{1B}[33m"
const style_cyan := "\u{1B}[36m"
const style_blue := "\u{1B}[34m"
const style_magenta := "\u{1B}[35m"

const style_italic := "\u{1B}[3m"
const style_bold := "\u{1B}[1m"
const style_dim := "\u{1B}[2m"
const style_reset := "\u{1B}[0m"

def pprintBool(z) {
      match z {
            :true => return [ style_green, "✔ true", style_reset ].print()
            :false => return [ style_red, "✘ false", style_reset ].print()
      }
}

def pprintString(z) { [ style_yellow, "'", z, "'", style_reset ].print() }

def pprintInteger(z) { [ style_cyan, z, style_reset ].print() }

def pprintVoidance(z, indent_level) {
      match z using v {
            :none => return [ style_dim, "∅ none", style_reset ].print()
            :error => return [ style_bright_red, "‼ error", style_reset ].print()
            ErrorAndReason => {
                  assertOk([ style_bright_red, "‼ error ", style_reset].print())
                  return internalPprint(v.1, indent_level + 1)
            }
      }
}

def pprintArray(z, indent_level) {
      switch indent_level {
            0 => :none
            else => assertOk(print(:nl))
      }
      repeat z.len using idx {
            elem := z[idx]
            switch indent_level {
                  0 => :none
                  else => {
                        repeat indent_level { assertOk(print(:t)) }
                        assertOk(print("• "))
                  }
            }

            match elem using inner {
                  Slice <Generic> => {
                        assertOk(print("↘"))
                        assertOk(pprintArray(inner, indent_level + 1))
                  }
                  Record => {
                        assertOk(pprintRecord(inner, indent_level + 1))
                  }
                  else => {
                        assertOk(internalPprint(inner, indent_level))
                  }
            }
            if {
                  idx < z.len - 1 => assertOk(print(:nl))
                  else => :none
            }
      }
      return :none
}

def pprintRecord(item, indent_level) {
      switch indent_level {
            0 => :none
            else => assertOk(print(:nl))
      }
      rec := item
      repeat rec.*.len using i {
            repeat indent_level { assertOk(print(:t)) }
            k := rec.*.key[i]
            v := rec.*.val[i]
            assertOk(print([k, style_blue, style_bold, ": ", style_reset]))
            match v using inner {
                  Record => assertOk(pprintRecord(inner, indent_level + 1))
                  Slice <Generic> => assertOk(pprintArray(inner, indent_level + 1))
                  else => {
                        assertOk(internalPprint(v, indent_level))
                  }
            }
            if {
                  i < rec.*.len - 1 => assertOk(print(:nl))
                  else => :none
            }
      }
      return :none
}

def internalPprint(item, indent_level) {
      match item using z {
            Bool => return pprintBool(z)
            Integer => return pprintInteger(z)
            String => return pprintString(z)
            Slice<Generic> => return pprintArray(z, indent_level)
            Record => return pprintRecord(z, indent_level)
            *Generic => return pprint(z.*)
            Voidance => return pprintVoidance(z, indent_level)
      }
}

pub func stdPrinter(ctx: *Context, item: Generic) -> IoError | :none {
      @ctx := ctx.*
      ret := internalPprint(item, 0)
      match ret {
            IoError => return ret
            else => return print(:nl)
      }
}

def hartPrintIndent(indent_level) {
      repeat indent_level {
            assertOk(print(:t))
      }
      return :none
}

def hartPrintArray(z, indent_level) {
      if {
            z.len = (0 as usize) => return print("[]")
            else => :none
      }
      assertOk(print("[\n"))
      repeat z.len using idx {
            hartPrintIndent(indent_level + 1)
            assertOk(internalHartPrint(z[idx], indent_level + 1))
            assertOk(print(:nl))
      }
      hartPrintIndent(indent_level)
      return print("]")
}

def hartPrintRecord(rec, indent_level) {
      if {
            rec.*.len = (0 as usize) => return print("{}")
            else => :none
      }
      assertOk(print("{\n"))
      repeat rec.*.len using i {
            hartPrintIndent(indent_level + 1)
            assertOk(print([rec.*.key[i], ": "]))
            assertOk(internalHartPrint(rec.*.val[i], indent_level + 1))
            assertOk(print(:nl))
      }
      hartPrintIndent(indent_level)
      return print("}")
}

def hartPrintVoidance(z, indent_level) {
      match z using v {
            :none => return print(":none")
            :error => return print(":error")
            ErrorAndReason => {
                  assertOk(print("(:error, "))
                  assertOk(internalHartPrint(v.1, indent_level))
                  return print(")")
            }
      }
}

def internalHartPrint(item, indent_level) {
      match item using z {
            Bool => match z {
                  :true => return print(":true")
                  :false => return print(":false")
            }
            Integer => return print(z)
            String => return print(["\"", z, "\""])
            Slice<Generic> => return hartPrintArray(z, indent_level)
            Record => return hartPrintRecord(z, indent_level)
            *Generic => return internalHartPrint(z.*, indent_level)
            Voidance => return hartPrintVoidance(z, indent_level)
      }
}

pub func debugPrinter(ctx: *Context, item: Generic) -> IoError | :none {
      @ctx := ctx.*
      ret := internalHartPrint(item, 0)
      match ret {
            IoError => return ret
            else => return print(:nl)
      }
}

pub def pprint(item) { @ctx.printer(@ctx.&, item) }
