mod std
use std::libc::*

pub type Printable :=
      String
      | Integer
      | :nl
      | :t
      | ( :softTab, UnsignedInteger )
      | Bool
      | Slice <Printable>

def checkPrintfRet(ret: s32) -> :none | IoError {
      return switch ret < 0 {
            :true => errnoToError()
            else => :none
      }
}

def printString(s: String) -> :none | IoError {
      return checkPrintfRet(printf("%.*s\0".ptr, s.len as s32, s.ptr))
}

def prNl() -> :none | IoError {
      return checkPrintfRet(printf("\n\0".ptr))
}

def prTab() -> :none | IoError {
      return checkPrintfRet(printf("\t\0".ptr))
}

def printSint(num: SignedInteger) -> :none | IoError {
      return checkPrintfRet(printf("%lld\0".ptr, num as s64))
}

def printUint(num: UnsignedInteger) -> :none | IoError {
      return checkPrintfRet(printf("%llu\0".ptr, num as u64))
}

def printa(arr: Slice<Printable>) -> :none | IoError {
      repeat arr.len using i {
            match print(arr[i]) using err {
                  IoError => return err
                  else => :none
            }
      }
      return :none
}

pub def print(x: Printable) -> :none | IoError {
      match x using z {
            String => return printString(z)
            SignedInteger => return printSint(z)
            UnsignedInteger => return printUint(z)
            :nl => return prNl()
            :t => return prTab()
            ( :softTab, UnsignedInteger ) => {
                  repeat (z.1 as usize) {
                        match print(" ") using err {
                              IoError => return err
                              else => :none
                        }
                  }
                  return :none
            }
            Slice <Printable> => return printa(z)
            Bool => match z {
                  :true => return print("true")
                  :false => return print("false")
            }
      }
}

pub def println(x: Printable) -> :none | IoError {
      return print([x, :nl])
}
