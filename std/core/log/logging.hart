mod std

const log_red := "\u{1B}[91m"
const log_yellow := "\u{1B}[33m"
const log_reset := "\u{1B}[0m"

def isLogged(target, min_level) {
      return match target {
            :info => min_level.info
            :warn => min_level.warn
            :error => min_level.error
            :never => :false
      }
}

func stdLogger(ctx: *Context, level: :info | :warn | :error | :never, min_level: LogLevel, line: u64, file: String, item: Generic) -> :none {
      @ctx := ctx.*

      if {
            isLogged(level, min_level) = :false => return :none
            else => :none
      }
      match level {
            :error => match print([log_red, "‼ error ", file, ":", line, ": ", log_reset]) { else => :none }
            :warn => match print([log_yellow, "⚠ warn ", file, ":", line, ": ", log_reset]) { else => :none }
            :info => match print([file, ":", line, ": "]) { else => :none }
            :never => return :none
      }
      match pprint(item) { else => :none }
      return :none
}

pub def log(item) { logWithLineAndFile(:info, @caller_line_number, @caller_file_name, item) }

pub def logWarn(item) { logWithLineAndFile(:warn, @caller_line_number, @caller_file_name, item) }

pub def logError(item) { logWithLineAndFile(:error, @caller_line_number, @caller_file_name, item) }

pub def logWithLineAndFile(level, line, file, item) { @ctx.logger(@ctx.&, level, @ctx.log_level, line, file, item) }
