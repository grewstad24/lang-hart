decl mod core {
      export { default_context } to std
      import { std, std.impl }
}

const default_context := {
      logger: stdLogger
      log_level: {
            info: :false
            warn: :true
            error: :true
      }
      memalloc: stdMemalloc
      resizeAlloc: stdResizeAlloc
      dealloc: stdDealloc
      printer: stdPrinter
      panic: stdPanic
      open: stdOpen
      close: stdClose
      read: stdRead
      write: stdWrite
      seek: stdSeek
}
