mod core

func stdMemalloc(ctx: *Context, size: usize) -> *mut opaque | :error {
      raw := malloc(size)
      if {
            raw as usize = 0 as usize => return :error
            else => return raw
      }
}

func stdResizeAlloc(ctx: *Context, ptr: *opaque, new_size: usize) -> *mut opaque | :error {
      raw := realloc(ptr, new_size)
      if {
            raw as usize = 0 as usize => return :error
            else => return raw
      }
}

func stdDealloc(ctx: *Context, ptr: *opaque) -> :none {
      free(ptr)
}

def memalloc(size) {
      return @ctx.memalloc(@ctx.&mut, size as usize)
}

def dealloc(ptr) {
      @ctx.dealloc(@ctx.&mut, ptr)
}

def resizeAlloc(ptr, new_size) {
      return @ctx.resizeAlloc(@ctx.&mut, ptr, new_size as usize)
}

def heapNew(x) {
      mut val := x
      ptr := assertOk(memalloc(@sizeOf val))
      typed_ptr := @asTypeOf(ptr, val.&mut)
      typed_ptr.* := val
      return typed_ptr
}
