mod core

type String := Slice <u8>

type Integer := SignedInteger | UnsignedInteger

type SignedInteger := s16 | s32 | s64 | ssize

type UnsignedInteger := u8 | u16 | u32 | u64 | usize

type Record := *{
      len: usize
      key: *String
      val: *Generic
}

type ErrorWithReason <T> := (:error, T)

type ErrorAndReason := (:error, Atom | Record)

type Error := ErrorAndReason | :error

type Voidance := Error | :none

type Bool := :true | :false

type Atom := { str: String }

type Slice <T> := {
      ptr: *T
      len: usize
}

type UnvoidGeneric :=
      Integer
      | String
      | Bool
      | Record
      | Slice <Generic>
      | Atom
      | *Generic

type Generic := UnvoidGeneric | Voidance

type LogLevel := {
      info: Bool
      warn: Bool
      error: Bool
}

type Context := {
      logger: func(*Context, :info | :warn | :error | :never, LogLevel, u64, String, Generic) -> :none
      log_level: LogLevel
      memalloc: func(*Context, usize) -> *mut opaque | :error
      resizeAlloc: func(*Context, *opaque, usize) -> *mut opaque | :error
      dealloc: func(*Context, *opaque) -> :none
      printer: func(*Context, Generic) -> :none | :error
      panic: func(*Context, Generic) -> never
}
