mod std

pub def not(b: Bool) -> Bool {
      return match b {
            :true => :false
            :false => :true
      }
}

pub def and(a: Bool, b: Bool) -> Bool {
      return match a {
            :true => b
            :false => :false
      }
}

pub def or(a: Bool, b: Bool) -> Bool {
      return match a {
            :true => :true
            :false => b
      }
}

pub def xor(a: Bool, b: Bool) -> Bool {
      return match a {
            :true => not(b)
            :false => b
      }
}

pub def nand(a: Bool, b: Bool) -> Bool { and(a, b).not() }

pub def nor(a: Bool, b: Bool) -> Bool { or(a, b).not() }

pub def xnor(a: Bool, b: Bool) -> Bool { xor(a, b).not() }

pub def implies(a: Bool, b: Bool) -> Bool { not(a).or(b) }

pub def all(slice) {
      repeat slice.len using i {
            match slice[i] {
                  :false => return :false
                  :true => :none
            }
      }
      return :true
}

pub def any(slice) {
      repeat slice.len using i {
            match slice[i] {
                  :true => return :true
                  :false => :none
            }
      }
      return :false
}

pub def ptrAddBytes(ptr, bytes) {
      return @asTypeOf(((ptr as usize) + (bytes as usize)) as *mut opaque, ptr)
}

pub def ptrSubBytes(ptr, bytes) {
      return @asTypeOf(((ptr as usize) - (bytes as usize)) as *mut opaque, ptr)
}

pub def ptrDiffBytes(a, b) -> usize {
      return (a as usize) - (b as usize)
}

pub def ptrAdd(ptr, count) {
      elem := ptr.*
      return @asTypeOf(((ptr as usize) + (count as usize) * @sizeOf(elem)) as *mut opaque, ptr)
}

pub def ptrSub(ptr, count) {
      elem := ptr.*
      return @asTypeOf(((ptr as usize) - (count as usize) * @sizeOf(elem)) as *mut opaque, ptr)
}

pub def fill(slice, val) {
      mut v := val
      raw := (slice.ptr as usize) as *mut opaque
      base := @asTypeOf(raw, v.&mut)
      repeat slice.len using i {
            elem_ptr := ptrAdd(base, i)
            elem_ptr.* := v
      }
      return :none
}

pub def nulTerminate(s: String) -> *mut u8 | :error {
      raw := match heapAlloc(s.len + 1) using res {
            :error => return res
            else => res
      }
      buf := raw as *mut u8
      repeat s.len using i {
            dst := ptrAdd(buf, i)
            dst.* := s[i]
      }
      end_ptr := ptrAdd(buf, s.len)
      end_ptr.* := 0
      return buf
}
