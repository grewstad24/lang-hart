mod std

pub type String := Slice <u8>

pub type Integer := SignedInteger | UnsignedInteger

pub type SignedInteger := s8 | s16 | s32 | s64 | ssize

pub type UnsignedInteger := u8 | u16 | u32 | u64 | usize

pub type Record := *{
      len: usize
      key: *String
      val: *Generic
}

pub type ErrorWithReason <T> := (:error, T)

pub type ErrorAndReason := (:error, String | Record)

pub type Error := ErrorAndReason | :error

pub type Voidance := Error | :none

pub type Bool := :true | :false

pub type Slice <T> := {
      ptr: *T
      len: usize
}

pub type Vec <T> := {
      items: Slice <T>
      cap: usize
}

pub type UnvoidGeneric :=
      Integer
      | String
      | Bool
      | Record
      | Slice <Generic>
      | *Generic

pub type Generic := UnvoidGeneric | Voidance

pub type IoError :=
      (:error, :permission_denied)
      | (:error, :not_found)
      | (:error, :interrupted)
      | (:error, :io_error)
      | (:error, :bad_fd)
      | (:error, :would_block)
      | (:error, :out_of_memory)
      | (:error, :access_denied)
      | (:error, :already_exists)
      | (:error, :not_a_directory)
      | (:error, :is_a_directory)
      | (:error, :invalid_argument)
      | (:error, :no_space)
      | (:error, :broken_pipe)
      | (:error, :unknown)

pub type LogLevel := {
      info: Bool
      warn: Bool
      error: Bool
}

pub type OpenMode := :read | :write | :append | :read_write

pub type SeekWhence := :start | :current | :end

pub type File := {
      fd: s32
}

pub type Context := {
      logger: func(*Context, :info | :warn | :error | :never, LogLevel, u64, String, Generic) -> :none
      log_level: LogLevel
      heap_alloc: func(*Context, usize) -> *mut opaque | :error
      heap_realloc: func(*Context, *opaque, usize) -> *mut opaque | :error
      heap_dealloc: func(*Context, *opaque) -> :none
      printer: func(*Context, Generic) -> :none | IoError
      panic: func(*Context, Generic) -> never
      open: func(*Context, String, OpenMode) -> s32 | IoError
      close: func(*Context, s32) -> :none | IoError
      read: func(*Context, s32, *mut u8, usize) -> usize | IoError
      write: func(*Context, s32, *u8, usize) -> usize | IoError
      seek: func(*Context, s32, s64, SeekWhence) -> u64 | IoError
}
