mod core

func stdPanic(ctx: *Context, reason: Generic) -> never {
      @ctx := ctx.*
      match reason using r {
            :none => logError("panic")
            else => logError(r)
      }
      abort()
}

def panic(reason) {
      @ctx.panic(@ctx.&mut, reason)
}

def assertOk(val) { return
      match val using v {
            :error => @ctx.panic(@ctx.&mut, :none)
            ErrorWithReason <Generic> => @ctx.panic(@ctx.&mut, v.1)
            else => v
      }
}
