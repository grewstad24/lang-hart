decl mod core {
      export {
            { String, Integer, SignedInteger, UnsignedInteger, Record, Generic, Atom, Slice, Bool,
              UnvoidGeneric, Voidance, Error, ErrorWithReason, ErrorAndReason, LogLevel, Context,
              malloc, free, realloc, abort, printf,
              stdMemalloc, stdResizeAlloc, stdDealloc,
              memalloc, dealloc, resizeAlloc, heapNew,
              stdLogger, isLogged, log, logWarn, logError, logWithLineAndFile,
              stdPrinter, print, println, internalPprint, pprintlnErr,
              style_red, style_bright_red, style_green, style_yellow, style_cyan, style_blue, style_magenta,
              style_italic, style_bold, style_dim, style_reset,
              assertOk, panic, stdPanic,
              add, sub, mul, div,
              default_context } to std,
            { malloc, free, realloc, abort, printf } to std.libc,
            { stdMemalloc, stdResizeAlloc, stdDealloc,
              stdLogger, isLogged,
              stdPrinter, internalPprint, pprintlnErr,
              stdPanic,
              style_red, style_bright_red, style_green, style_yellow, style_cyan, style_blue, style_magenta,
              style_italic, style_bold, style_dim, style_reset } to std.impl
      }
}
