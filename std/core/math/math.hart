mod std

pub def add(a, b) { a + b }

pub def sub(a, b) { a - b }

pub def mul(a, b) { a * b }

pub def div(a, b) { a / b }

pub def min(a, b) {
      return if {
            a < b => a
            else => b
      }
}

pub def max(a, b) {
      return if {
            a > b => a
            else => b
      }
}

pub def abs(x) {
      return if {
            x < 0 => 0 - x
            else => x
      }
}

pub def clamp(x, lo, hi) { min(max(x, lo), hi) }
