mod core

def isLogged(target, min_level) {
      return match target {
            :info => min_level.info
            :warn => min_level.warn
            :error => min_level.error
            :never => :false
      }
}

func stdLogger(ctx: *Context, level: :info | :warn | :error | :never, min_level: LogLevel, line: u64, file: String, item: Generic) -> :none {
      @ctx := ctx.*

      if {
            isLogged(level, min_level) = :false => return :none
            else => :none
      }
      match level {
            :error => {
                  assertOk(print([style_bright_red, "‼ error ", style_reset, file, ":", line, ": "]))
                  assertOk(pprintlnErr(item))
            }
            :warn => {
                  assertOk(print([style_yellow, "⚠ warn ", style_reset, file, ":", line, ": "]))
                  assertOk(pprintlnErr(item))
            }
            :info => {
                  assertOk(print([file, ":", line, ": "]))
                  assertOk(@ctx.printer(@ctx.&, item))
            }
            :never => :none
      }
}

def log(item) {
      @ctx.logger(@ctx.&, :info, @ctx.log_level, @caller_line_number, @caller_file_name, item)
}

def logWarn(item) {
      @ctx.logger(@ctx.&, :warn, @ctx.log_level, @caller_line_number, @caller_file_name, item)
}

def logError(item) {
      @ctx.logger(@ctx.&, :error, @ctx.log_level, @caller_line_number, @caller_file_name, item)
}

def logWithLineAndFile(level, line, file, item) {
      @ctx.logger(@ctx.&, level, @ctx.log_level, line, file, item)
}
