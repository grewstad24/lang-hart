export {
      { stdLogger, isLogged } to .std.impl
      { stdLogger } to .std_impl.log
      { log, logWarn, logError, logWithLineAndFile } to .std
      { log, logWarn, logError, logWithLineAndFile } to .log
}
import { .print, .print.pretty }

func isLogged(target: :info | :warn | :error | :never, min_level: LogLevel) -> Bool {
      return match target {
            :info => min_level.info
            :warn => min_level.warn
            :error => min_level.error
            :never => :false
      }
}

func stdLogger(level: :info | :warn | :error | :never, min_level: LogLevel, line: u64, file: String, item: Generic) -> :none {
      @ctx := default_context
      if {
            isLogged(level, min_level) = :false => return :none
            else => :none
      }
      match level {
            :error => {
                  print([style_bright_red, "‼ error ", style_reset, file, ":", line, ": "])
                  pprintlnErr(item)
            }
            :warn => {
                  print([style_yellow, "⚠ warn ", style_reset, file, ":", line, ": "])
                  pprintln(item)
            }
            :info => {
                  print([file, ":", line, ": "])
                  pprintln(item)
            }
            :never => :none
      }
}

def log(item) {
      @ctx.logger(:info, @ctx.log_level, @caller_line_number, @caller_file_name, item)
}

def logWarn(item) {
      @ctx.logger(:warn, @ctx.log_level, @caller_line_number, @caller_file_name, item)
}

def logError(item) {
      @ctx.logger(:error, @ctx.log_level, @caller_line_number, @caller_file_name, item)
}

def logWithLineAndFile(level, line, file, item) {
      @ctx.logger(level, @ctx.log_level, line, file, item)
}
