mod std

pub def vecInit(init) {
      match init using s {
            :none => return {
                  items: {
                        ptr: (0 as usize) as *opaque
                        len: 0 as usize
                  }
                  cap: 0 as usize
            }
            else => {
                  if {
                        s.len = (0 as usize) => return {
                              items: {
                                    ptr: @asTypeOf((0 as usize) as *opaque, s.ptr)
                                    len: 0 as usize
                              }
                              cap: 0 as usize
                        }
                        else => :none
                  }
                  mut first := s[0]
                  raw := assertOk(heapAlloc(s.len * @sizeOf(first)))
                  typed_ptr := @asTypeOf(raw, first.&mut)
                  repeat s.len using i {
                        elem_raw := ((raw as usize) + i * (@sizeOf(first))) as *mut opaque
                        elem_ptr := @asTypeOf(elem_raw, first.&mut)
                        elem_ptr.* := s[i]
                  }
                  return {
                        items: {
                              ptr: @asTypeOf(typed_ptr, first.&)
                              len: s.len
                        }
                        cap: s.len
                  }
            }
      }
}
