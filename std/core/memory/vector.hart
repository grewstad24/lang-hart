mod std

pub def vecInit(init) {
      match init using s {
            :none => return {
                  items: {
                        ptr: (0 as usize) as *opaque
                        len: 0 as usize
                  }
                  cap: 0 as usize
            }
            else => {
                  if {
                        s.len = (0 as usize) => return {
                              items: {
                                    ptr: @asTypeOf((0 as usize) as *opaque, s.ptr)
                                    len: 0 as usize
                              }
                              cap: 0 as usize
                        }
                        else => :none
                  }
                  mut first := s[0]
                  mut raw := (0 as usize) as *mut opaque
                  alloc_res := heapAlloc(s.len * @sizeOf(first))
                  match alloc_res using res {
                        :error => return res
                        else => raw := res
                  }
                  repeat s.len using i {
                        elem_raw := ((raw as usize) + i * (@sizeOf(first))) as *mut opaque
                        elem_ptr := @asTypeOf(elem_raw, first.&mut)
                        elem_ptr.* := s[i]
                  }
                  return {
                        items: {
                              ptr: @asTypeOf(raw, first.&)
                              len: s.len
                        }
                        cap: s.len
                  }
            }
      }
}
