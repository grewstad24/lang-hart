mod std

pub def vecEmpty() {
      return {
            items: {
                  ptr: (0 as usize) as *opaque
                  len: 0 as usize
            }
            cap: 0 as usize
      }
}

pub def vecInit(s) {
      if {
            s.len = 0 => return {
                  items: {
                        ptr: @asTypeOf((0 as usize) as *opaque, s.ptr)
                        len: 0 as usize
                  }
                  cap: 0 as usize
            }
      }
      mut first := s[0]
      mut raw := (0 as usize) as *mut opaque
      alloc_res := heapAlloc(s.len * @sizeOf(first))
      match alloc_res using res {
            :error => return res
            else => raw := res
      }
      base := @asTypeOf(raw, first.&mut)
      repeat s.len using i {
            elem_ptr := ptrAdd(base, i)
            elem_ptr.* := s[i]
      }
      return {
            items: {
                  ptr: @asTypeOf(raw, first.&)
                  len: s.len
            }
            cap: s.len
      }
}
