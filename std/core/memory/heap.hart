decl mod memory {
      export {
            { heapAlloc, heapDealloc, heapRealloc, heapNew, vecInit } to std,
            { stdHeapAlloc, stdHeapRealloc, stdHeapDealloc } to std_impl
      }
      import { std, std_libc }
}

func stdHeapAlloc(ctx: *Context, size: usize) -> *mut opaque | :error {
      raw := malloc(size)
      return switch raw as usize {
            0 as usize => :error
            else => raw
      }
}

func stdHeapRealloc(ctx: *Context, ptr: *opaque, new_size: usize) -> *mut opaque | :error {
      raw := realloc(ptr, new_size)
      return switch raw as usize {
            0 as usize => :error
            else => raw
      }
}

func stdHeapDealloc(ctx: *Context, ptr: *opaque) -> :none { free(ptr) }

def heapAlloc(size) { @ctx.heap_alloc(@ctx.&mut, size as usize) }

def heapDealloc(ptr) { @ctx.heap_dealloc(@ctx.&mut, ptr) }

def heapRealloc(ptr, new_size) { @ctx.heap_realloc(@ctx.&mut, ptr, new_size as usize) }

def heapNew(x) {
      mut val := x
      ptr := assertOk(heapAlloc(@sizeOf val))
      typed_ptr := @asTypeOf(ptr, val.&mut)
      typed_ptr.* := val
      return typed_ptr
}
