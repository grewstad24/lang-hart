mod std
use std::libc::*

func stdHeapAlloc(ctx: *Context, size: usize) -> *mut opaque | :error {
      raw := malloc(size)
      return switch raw as usize {
            0 as usize => :error
            else => raw
      }
}

func stdHeapRealloc(ctx: *Context, ptr: *opaque, new_size: usize) -> *mut opaque | :error {
      raw := realloc(ptr, new_size)
      return switch raw as usize {
            0 as usize => :error
            else => raw
      }
}

func stdHeapDealloc(ctx: *Context, ptr: *opaque) -> :none { free(ptr) }

pub def heapAlloc(size) { @ctx.heap_alloc(@ctx.&mut, size as usize) }

pub def heapDealloc(ptr) { @ctx.heap_dealloc(@ctx.&mut, ptr) }

pub def heapRealloc(ptr, new_size) { @ctx.heap_realloc(@ctx.&mut, ptr, new_size as usize) }

pub def heapNew(x) {
      mut val := x
      alloc_res := heapAlloc(@sizeOf(val))
      match alloc_res using ptr {
            :error => return ptr
            else => {
                  typed_ptr := @asTypeOf(ptr, val.&mut)
                  typed_ptr.* := val
                  return typed_ptr
            }
      }
}
