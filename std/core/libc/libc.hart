mod std::libc

pub extern func malloc(size: usize) -> *mut opaque
pub extern func free(ptr: *opaque) -> :none
pub extern func realloc(ptr: *opaque, new_size: usize) -> *mut opaque
pub extern func abort() -> never
pub extern func printf(ptr: *u8, ...) -> s32
pub extern func __errno_location() -> *s32

pub extern func open(path: *u8, flags: s32, mode: s32) -> s32
pub extern func close(fd: s32) -> s32
pub extern func read(fd: s32, buf: *u8, bytes: usize) -> s64
pub extern func write(fd: s32, buf: *u8, bytes: usize) -> s64
pub extern func lseek(fd: s32, offset: s64, whence: s32) -> s64
