decl mod heap {
      export {
            { stdMemalloc, stdResizeAlloc, stdDealloc } to .std_impl.heap
            { memalloc, dealloc, resizeAlloc, heapNew } to .heap
      }
}

extern func malloc(size: usize) -> *mut opaque
extern func free(ptr: *opaque) -> :none
extern func realloc(ptr: *opaque, new_size: usize) -> *mut opaque


func stdMemalloc(size: usize) -> *mut opaque {
      return malloc(size)
}

func stdResizeAlloc(ptr: *opaque, new_size: usize) -> *mut opaque {
      return realloc(ptr, new_size)
}

func stdDealloc(ptr: *opaque) -> :none {
      free(ptr)
}


def memalloc(size) {
      return @ctx.memalloc(size as usize)
}

def dealloc(ptr) {
      @ctx.dealloc(ptr)
}

def resizeAlloc(ptr, new_size) {
      return @ctx.resizeAlloc(ptr, new_size as usize)
}

def heapNew(x) {
      mut val := x
      ptr := memalloc(@sizeOf val)
      typed_ptr := @asTypeOf(ptr, val.&mut)
      typed_ptr.* := val
      return typed_ptr
}
