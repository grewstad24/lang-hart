export { stdLogger, logInfo, logWarn, logError, isLogged } to .log
import { .print, .print.pretty }

func isLogged(target: LogLevel, min_level: LogLevel) -> Bool {
      return match min_level {
            :info => :true
            :warn => match target {
                  :info => :false
                  else => :true
            }
            :error => match target {
                  :error => :true
                  else => :false
            }
            :never => :false
      }
}

func stdLogger(level: LogLevel, min_level: LogLevel, line: u64, file: String, item: Generic) -> :none {
      @ctx := default_context
      if {
            isLogged(level, min_level) = :false => return :none
            else => :none
      }
      match level {
            :error => {
                  print([style_bright_red, "‼ error ", style_reset, file, ":", line, ": "])
                  pprintlnErr(item)
            }
            :warn => {
                  print([style_yellow, "⚠ warn ", style_reset, file, ":", line, ": "])
                  pprintln(item)
            }
            :info => {
                  print([file, ":", line, ": "])
                  pprintln(item)
            }
            :never => :none
      }
}

def logInfo(item) {
      @ctx.logger(:info, @ctx.log_level, @caller_line_number, @caller_file_name, item)
}

def logWarn(item) {
      @ctx.logger(:warn, @ctx.log_level, @caller_line_number, @caller_file_name, item)
}

def logError(item) {
      @ctx.logger(:error, @ctx.log_level, @caller_line_number, @caller_file_name, item)
}
