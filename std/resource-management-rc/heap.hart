decl mod reman_heap {
      import { .heap, .reman, .extend.reman }
      export {
            { rcHeapNew, rcMalloc, rcFree } to .reman.heap
      }
}

def rcHeapNew(value) {
      ptr := alloc(type RcBlock)
      ptr.*.refcount := 1 as usize
      ptr.*.sink := free
      ptr.*.value := value as *opaque
      return ptr
}

def rcMalloc(size: usize) {
      mem := malloc(size)
      return rcNew(mem, free)
}

def rcFree(rc) {
      rcDrop(rc)
}
