decl mod reman_heap {
      import { .heap, .reman, .extend.reman }
      export {
            { rcHeapNew, rcMalloc, rcFree } to .reman.heap
      }
}

def rcHeapNew(value) {
      return rcNew(value, free)
}

def rcMalloc(size: usize) {
      mem := malloc(size)
      return rcNew(mem, free)
}

def rcFree(rc) {
      rcDrop(rc)
}
