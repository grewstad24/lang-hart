decl mod reman {
      import { .heap }
      export {
            { rcNew, rcDrop, rcShare } to .reman,
            { rcDrop, rcShare, rcNew, RcBlock } to .extend.reman
      }
}

type RcBlock := {
      refcount: usize,
      sink: func(*opaque) -> :none,
      value: *opaque
}

def rcNew(value, sink_fn: func(*opaque) -> :none) {
      ptr := alloc(type RcBlock)
      ptr.*.refcount := 1
      ptr.*.sink := sink_fn
      ptr.*.value := value
      return ptr
}

def rcShare(rc) {
      rc.*.refcount := rc.*.refcount + 1
      return rc
}

def rcDrop(rc) {
      if {
            rc.*.refcount <= 1 => {
                  rc.*.sink(rc.*.value)
                  free(rc)
            }
            else => {
                  rc.*.refcount := rc.*.refcount - 1
            }
      }
}
