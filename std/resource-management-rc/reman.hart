decl mod reman {
      import { .heap }
      export {
            { rcNew, rcDrop, rcShare } to .reman,
            { rcDrop, rcShare, rcNew, RcBlock } to .extend.reman
      }
}

type RcBlock := {
      refcount: usize,
      sink: func(*opaque) -> :none,
      value: *opaque
}

def rcNew(value, sink_fn: func(*opaque) -> :none) {
      mut block: RcBlock := {
            refcount: 1,
            sink: sink_fn,
            value: value
      }
      mut ptr: *mut RcBlock := malloc(@sizeOf block)
      ptr.* := block
      return ptr
}

def rcShare(rc) {
      rc.*.refcount := rc.*.refcount + 1
      return rc
}

def rcDrop(rc) {
      if {
            rc.*.refcount <= 1 => {
                  rc.*.sink(rc.*.value)
                  free(rc)
            }
            else => {
                  rc.*.refcount := rc.*.refcount - 1
            }
      }
}
