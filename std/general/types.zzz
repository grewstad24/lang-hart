export { String, Integer, SignedInteger, UnsignedInteger, Record, Generic } to .


type String := []u8


type Integer := u16 | u32 | u64 | s16 | s32 | s64


type SignedInteger := s16 | s32 | s64


type UnsignedInteger := u16 | u32 | u64


type Record := *(
      len: usize
      key: *String
      val: *Generic
)

type Atom := ( str: String )


type Generic := Integer | String | bool | Record | []Generic
