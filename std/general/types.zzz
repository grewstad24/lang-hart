export { String, Integer, SignedInteger, UnsignedInteger, Record, Generic, Atom, Slice, Bool } to .


type String := Slice <u8>

type Integer := SignedInteger | UnsignedInteger

type SignedInteger := s16 | s32 | s64

type UnsignedInteger := u16 | u32 | u64

type Record := *(
      len: usize
      key: *String
      val: *Generic
)

type Bool := :true | :false

type Atom := ( str: String )

meta type Slice <T> := (
      ptr: *T
      len: usize
)

type Generic :=
      Integer
      | String
      | Bool
      | Record
      | Slice <Generic>
      | Atom
