export { not, and, or, xor, nand, nor, xnor, neg, strEq, andThen } to .

def neg(x) { 0 - x }

# 1 -> 0
# 0 -> 1
def not(x) {
      return match x {
            :true => :false
            :false => :true
      }
}

# 1,1 -> 1
# 1,0 -> 0
# 0,0 -> 0
def and(a, b) {
      return match a {
            :true => b
            :false => :false
      }
}

# 1,1 -> 1
# 1,0 -> 1
# 0,0 -> 0
def or(a, b) {
      return match a {
            :true => :true
            :false => b
      }
}

# 1,1 -> 0
# 1,0 -> 1
# 0,0 -> 0
def xor(a, b) {
      return match a {
            :true => not(b)
            :false => b
      }
}

def nand(a, b) { not(and(a, b)) }

def nor(a, b) { not(or(a, b)) }

def xnor(a, b) { not(xor(a, b)) }

def strEq(a, b) {
      # length short-circuit
      if {
            a.len != b.len => return :false
            else => :none
      }
      repeat a.len using i {
            if {
                  # element short-circuit
                  a[i] != b[i] => return :false
                  else => :none
            }
      }
      return :true
}

def andThen(v, callback, arr) {
      match v {
            Voidance => return v
            else => return callback(v, ...arr)
      }
}

