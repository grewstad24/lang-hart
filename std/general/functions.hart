export { not, and, or, xor, nand, nor, xnor, neg, str_eq } to .

def neg(x) { 0 - x }

def not(x) {
      return match x {
            :true => :false
            :false => :true
      }
}

def and(a, b) {
      return match a {
            :true => b
            :false => :false
      }
}

def or(a, b) {
      return match a {
            :true => :true
            :false => b
      }
}

def xor(a, b) {
      return match a {
            :true => not(b)
            :false => b
      }
}

def nand(a, b) { not(and(a, b)) }

def nor(a, b) { not(or(a, b)) }

def xnor(a, b) { not(xor(a, b)) }

def str_eq(a, b) {
      # length short-circuit
      if {
            a.len != b.len => return :false
            else => :none
      }
      repeat a.len using i {
            if {
                  # element short-circuit
                  a[i] != b[i] => return :false
                  else => :none
            }
      }
      return :true
}
