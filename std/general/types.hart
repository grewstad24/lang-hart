export { String, Integer, SignedInteger, UnsignedInteger, Record, Generic, Atom, Slice, Bool, UnvoidGeneric, Voidance, Error, ErrorAndReason, LogLevel, Context } to .


type String := Slice <u8>

type Integer := SignedInteger | UnsignedInteger

type SignedInteger := s16 | s32 | s64 | ssize

type UnsignedInteger := u8 | u16 | u32 | u64 | usize

type Record := *{
      len: usize
      key: *String
      val: *Generic
}

type ErrorAndReason := (:error, Atom | Record)

type Error := ErrorAndReason | :error

type Voidance := Error | :none

type Bool := :true | :false

type Atom := { str: String }

type Slice <T> := {
      ptr: *T
      len: usize
}

type UnvoidGeneric :=
      Integer
      | String
      | Bool
      | Record
      | Slice <Generic>
      | Atom
      | *Generic

type Generic := UnvoidGeneric | Voidance

type LogLevel := :info | :warn | :error | :never

type Context := {
      logger: func(LogLevel, LogLevel, u64, String, Generic) -> :none
      log_level: LogLevel
      memalloc: func(usize) -> *mut opaque
      resizeAlloc: func(*opaque, usize) -> *mut opaque
      dealloc: func(*opaque) -> :none
}
