import { std }

func main(args: Slice<String>) -> :none {
      @ctx := default_context
      @ctx.log_level.info := :true

      log("hart testing suite initialized")

      mut buf := assertOk(memalloc(32))
      buf := resizeAlloc(buf, 64).assertOk()
      dealloc(buf)

      val := heapNew(42)
      raw := assertOk(memalloc(8))
      typed := raw.@asTypeOf(val)
      typed.* := 100

      log(val.*)
      log(typed.*)
      log(@sizeOf(val))

      dealloc(val)
      dealloc(raw)

      @ctx.printer := debugPrinter
      log({ a: 1, b: [2, :ok, "hi", :true] })

      logWarn("heap validation passed")
}
