import { std }

func main(args: Slice<String>) -> :none {
      @ctx := default_context
      log("hello from main")
      log({ name: "alice" })
      logWarn([1, 10, 15])
      logError("bye from main")

      print(:nl).assertOk()

      @ctx.printer := debugPrinter
      log("hello from main")
      log({ name: "alice" })
      logWarn([1, 10, 15])
      logError("bye from main")

      v_empty := vecInit(:none)
      v_nums := vecInit([1, 2, 3])
      assertOk(pprint(v_empty.items.len))
      assertOk(pprint(v_nums.cap))
      fill(v_nums.items, 9)
      s := v_nums.items
      e0 := s.ptr[0]
      e2 := s.ptr[2]
      assertOk(pprint(e0))
      assertOk(pprint(e2))
}
