import { .print, .io }

func main(args: Slice<String>) -> :none {
      println("--- testing repeat while ---")
      mut i := 0
      repeat while i < 3 {
            println(@slice [ "while i = ", i ])
            i := i + 1
      }

      println("--- testing repeat until ---")
      mut j := 0
      repeat until j >= 3 {
            println(@slice [ "until j = ", j ])
            j := j + 1
      }

      println("--- testing repeat for array ---")
      mut arr := [ 10, 20, 30 ]
      repeat for arr using elem {
            println(@slice [ "elem = ", elem ])
      }

      println("--- testing pre/post check semantics ---")
      mut count_while := 0
      repeat while :false {
            count_while := count_while + 1
      }
      println(@slice [ "while executed times: ", count_while ])

      mut count_until := 0
      repeat until :true {
            count_until := count_until + 1
      }
      println(@slice [ "until executed times: ", count_until ])

      println("--- testing break in while ---")
      mut k := 0
      repeat while :true {
            if {
                  k >= 3 => break
                  else => :none
            }
            println(@slice [ "break while k = ", k ])
            k := k + 1
      }

      println("--- testing continue in while ---")
      mut c := 0
      repeat while c < 4 {
            c := c + 1
            if {
                  c = 2 => continue
                  else => :none
            }
            println(@slice [ "continue while c = ", c ])
      }

      println("--- testing break and continue in repeat N ---")
      repeat 5 using idx {
            if {
                  idx = 1 as usize => continue
                  idx = 3 as usize => break
                  else => :none
            }
            println(@slice [ "repeat N idx = ", idx as s32 ])
      }

      println("--- testing break and continue in repeat for ---")
      mut numbers := [ 100, 200, 300, 400 ]
      repeat for numbers using num {
            if {
                  num = 200 => continue
                  num = 400 => break
                  else => :none
            }
            println(@slice [ "for num = ", num ])
      }

      println("--- testing stdlib file write and read with loops ---")
      mut w_res := write_file("test_loop_io.txt", "Hello from looped I/O!")
      match w_res {
            :ok => println("write succeeded")
            (:error, :open_failed) => println("write open failed")
            else => println("write other")
      }
      mut content := read_file("test_loop_io.txt")
      match content using ct {
            String => println(@slice [ "read file content: ", ct ])
            (:error, :open_failed) => println("error: open failed")
            (:error, :seek_failed) => println("error: seek failed")
            else => println("other error")
      }

      println("--- testing str_eq ---")
      if {
            str_eq("hello", "hello") => println("str_eq identical: true")
            else => println("str_eq identical: false")
      }
      if {
            str_eq("hello", "world") => println("str_eq different: true")
            else => println("str_eq different: false")
      }

      println("--- testing io stream_fd (repeat until) ---")
      mut read_file_handle := open_file("test_loop_io.txt")
      if {
            read_file_handle.is_ok() => {
                  read_file_handle.stream(64, on_chunk)
                  read_file_handle.close_file()
            }
            else => println("failed to open for streaming")
      }

      println("--- testing stdin, stdout, stderr constants ---")
      println(@slice [ "stdin.fd = ", stdin.fd ])
      println(@slice [ "stdout.fd = ", stdout.fd ])
      println(@slice [ "stderr.fd = ", stderr.fd ])

      println("--- testing early return from nested block and loops ---")
      println(@slice [ "early_return_nested_block(42) = ", early_return_nested_block(42) ])
      println(@slice [ "early_return_nested_block(15) = ", early_return_nested_block(15) ])
      println(@slice [ "early_return_nested_block(5) = ", early_return_nested_block(5) ])
      println(@slice [ "early_return_from_loop(3) = ", early_return_from_loop(3) ])
      println(@slice [ "early_return_from_loop(99) = ", early_return_from_loop(99) ])
      println(@slice [ "early_return_from_while(7) = ", early_return_from_while(7) ])
      println(@slice [ "early_return_from_while(50) = ", early_return_from_while(50) ])

      println("--- testing compound assignments +=, -=, *=, /= ---")
      mut ca := 10
      ca += 5
      println(@slice [ "10 += 5 => ", ca ])
      ca -= 3
      println(@slice [ "15 -= 3 => ", ca ])
      ca *= 4
      println(@slice [ "12 *= 4 => ", ca ])
      ca /= 6
      println(@slice [ "48 /= 6 => ", ca ])

      println("--- testing implicit widening and contextual literals ---")
      mut literal_usize: usize := 100
      mut literal_s64: s64 := 500
      mut b: u8 := 42
      mut wide_u32: u32 := b
      mut wide_usize: usize := b
      println(@slice [ "u8 widened to u32: ", wide_u32 ])
      println(@slice [ "u8 widened to usize: ", wide_usize ])
      mut sum := literal_usize + b
      println(@slice [ "literal_usize + u8: ", sum ])
      if {
            b < literal_usize => println("b < literal_usize is true without casts")
      }

      println("--- testing synthesized else => :none in if and switch ---")
      mut test_synth_if := 0
      if {
            test_synth_if = 0 => println("if without else arm works!")
      }

      mut test_synth_sw := 1
      switch test_synth_sw {
            1 => println("switch without else arm works!")
      }

      println("--- testing yield expression in blocks and functions ---")
      mut simple_yield := {
            mut bx := 10
            yield bx * 3
      }
      println(@slice [ "simple block yield: ", simple_yield ])

      println(@slice [ "test_block_yield(1): ", test_block_yield(1) ])
      println(@slice [ "test_block_yield(2): ", test_block_yield(2) ])
      println(@slice [ "test_block_yield(99): ", test_block_yield(99) ])

      println(@slice [ "func_yield_double(21): ", func_yield_double(21) ])

      println(@slice [ "test_yield_vs_return(0) (early function return): ", test_yield_vs_return(0) ])
      println(@slice [ "test_yield_vs_return(5) (block yield): ", test_yield_vs_return(5) ])
}

func on_chunk(chunk: String) -> :none { println(@slice [ "streamed chunk: '", chunk, "'" ]) }

def early_return_nested_block(val: s32) {
      if {
            val > 10 => {
                  if {
                        val = 42 => return 100
                        else => return 200
                  }
            }
            else => :none
      }
      return 0
}

def early_return_from_loop(target: s32) {
      repeat 10 using i {
            if {
                  (i as s32) = target => return (i as s32) * 10
                  else => :none
            }
      }
      return 0 - 1
}

def early_return_from_while(target: s32) {
      mut cur := 0
      repeat while cur < 20 {
            if {
                  cur = target => return cur * 5
                  else => :none
            }
            cur += 1
      }
      return 0 - 99
}

def test_block_yield(val: s32) {
      res := {
            if {
                  val = 1 => yield 111
                  val = 2 => yield 222
                  else => yield 333
            }
      }
      return res
}

def func_yield_double(x: s32) {
      yield x * 2
}

def test_yield_vs_return(flag: s32) {
      res := {
            if {
                  flag = 0 => return 9999
                  else => :none
            }
            yield flag + 10
      }
      return res * 2
}
