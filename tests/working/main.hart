use std::*

func main() -> :none {
      @ctx := default_context
      log("hello from main")
      log({ name: "alice" })
      logWarn([-1, 10, 15])
      logError("bye from main")

      print(:nl).must()

      @ctx := { ...@ctx, printer: debugPrinter }
      log("hello from main")
      log({ name: "alice" })
      logWarn([1, 10, 15])
      logError("bye from main")

      v_empty := vecEmpty()
      v_nums := vecInit([1, 2, 3]).must()
      defer heapDealloc(v_nums.items.ptr as *opaque)

      pprint(v_empty.items.len).must()
      pprint(v_nums.cap).must()
      fill(v_nums.items, 9)
      s := v_nums.items
      e0 := s.ptr[0]
      e2 := s.ptr[2]

      pprint(e0).must()
      pprint(e2).must()
}
