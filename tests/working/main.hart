import { .print, .print.pretty, .log }

func customLogger(level: LogLevel, line: u64, file: String, item: Generic) -> :none {
      @ctx := { logger: customLogger }
      match level using lvl {
            :info => print("[CUSTOM-INFO] ")
            :warn => print("[CUSTOM-WARN] ")
            :error => print("[CUSTOM-ERROR] ")
      }
      print(file)
      print(":")
      print(line)
      print(": ")
      pprint(item)
}

def logDirect(msg) {
      @ctx.logger(:info, @caller_line_number, @caller_file_name, msg)
}

def\ child() {
      logInfo(42)
}

def intermediate() {
      @ctx.logger := customLogger
      child()
}

func main(args: Slice<String>) -> :none {
      @ctx := { logger: stdLogger }

      @ctx.logger(:info, @this_line_number, @this_file_name, "direct log from main")

      logDirect("logged via def function")

      intermediate()

      @ctx.logger(:warn, @this_line_number, @this_file_name, "caller context preserved")
}
