import { .std }

func main(args: Slice<String>) -> :none {
      @ctx := default_context
      @ctx.log_level.info := :true

      log("hart testing suite initialized")

      mut buf := memalloc(32)
      buf := resizeAlloc(buf, 64)
      dealloc(buf)

      val := heapNew(42)
      raw := memalloc(8)
      typed := raw.@asTypeOf(val)
      typed.* := 100

      log(val.*)
      log(typed.*)
      log(@sizeOf(val))

      dealloc(val)
      dealloc(raw)

      logWarn("heap validation passed")
}
