import { .print, .print.pretty, .log }

def loadConfig(path) {
      logInfo("loading configuration file")
      logWarn("cache directory not configured, falling back to /tmp/cache")
      return :true
}

def processItem(id, status) {
      match status {
            :ok => {
                  logInfo("task completed successfully")
            }
            :stale => {
                  logWarn("task is stale, queuing refresh")
            }
            :corrupt => {
                  logError("task failed checksum validation")
            }
      }
}

def noisyWorker() {
      # Suppress verbose info logs for this worker subtree
      @ctx.log_level := :warn
      logInfo("this verbose message will be filtered out")
      logWarn("high memory threshold exceeded in worker pool")
}

func main(args: Slice<String>) -> :none {
      @ctx := default_context
      @ctx.log_level := :never

      logInfo("initializing background daemon")

      loadConfig("/etc/hart/daemon.conf")

      logInfo("processing incoming queue...")
      processItem(101, :ok)
      processItem(102, :stale)
      processItem(103, :ok)
      processItem(104, :corrupt)

      noisyWorker()

      logInfo("daemon shutdown gracefully")
}
