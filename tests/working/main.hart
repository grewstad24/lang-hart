import { .print, .heap, .reman, .reman.heap, .print.pretty, .math, .io }

func double_num(n: s32) -> s32 {
    return n + n
}

func apply_fn(x: s32, f: func(s32) -> s32) -> s32 {
    return f(x)
}

type Runner := {
    step: func(s32) -> s32
}

func main() -> :none {
      r := rcMalloc(64 as usize)
      rcShare(r)
      rcDrop(r)
      rcDrop(r)

      # UFCS chaining with '.'
      val := 10.neg().neg()
      println(val)

      # Higher-order function passed directly, called directly with f(x)
      res := apply_fn(21, double_num)
      println(res)

      # Struct field holding function pointer: field has higher priority than UFCS
      mut runner: Runner := { step: double_num }
      res2 := runner.step(25)
      println(res2)

      # @sizeOf operating on value
      sz := @sizeOf val
      println(sz as s32)
      sz2 := @sizeOf runner
      println(sz2 as s32)

      b := :true.not()
      println(b)
      b2 := :true.and(:false)
      println(b2)
      b3 := :true.or(:false)
      println(b3)

      pprint("Testing pprint")
      pprint(@record { a: 1, b: 2 })
      sum := add(5, 7)
      println(sum)

      print("Hello, World!")
}
