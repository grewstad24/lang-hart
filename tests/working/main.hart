import { .print.pretty }

func customPrinter(x: Generic) -> :none {
      concretePprintln("[custom]")
      concretePprintln(x)
      return :none
}

def child() {
      @ctx.printer(42)
}

def intermediate() {
      @ctx.printer := customPrinter
      child()
}

func main(args: Slice<String>) -> :none {
      @ctx := { printer: concretePprintln }

      intermediate()
      @ctx.printer("caller context preserved")
}
