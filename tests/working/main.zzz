import { .print.pretty, .heap, .math }

const greeting := "hello"

fn main() -> :none {
      ptr1 := heap_new(5)
      ptr2 := heap_new(greeting)

      sum1 := add(10, 25)
      sum2 := add(10 as u16, 35 as u16)
      pprint(@generalise {
            first_ptr := ptr1.*
            second_ptr := ptr2.*
            first_sum := sum1
            second_sum := sum2
      })
}
