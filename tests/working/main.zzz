@main
do to s32
        10 -> x
        20 as s16 -> y
        30 as s64 -> z

        println(x)
        println(y)
        println(z)

        pr_nl()

        (
                @name "bob"
                @details (
                        @age 50
                        @id "bob345"
                )
        ) `print_user()

        return 0
done

@type User
(
        name :: String
        details :: (
                age :: s32
                id :: String
        )
)

@val print_user
do ( user :: User )
        print("Name: ")
        println(user.name)

        pr_nl()

        println("Details: ")
        print("    Age: ")
        println(user.details.age)

        print("    ID: ")
        println(user.details.id)
done

@val print_s32
do ( num :: s32 )
        print(num)
done
