fn main() -> :none {
        @record (
                id := "bob123"
                number := 68
                valid := true
                more := (
                        is_cool := false
                        friend := "alice345"
                )
        ) ..print()

        5..
        add(5)..
        sub(3)..
        mul(65)..
        div(65)..
        println()

        var a := 100
        let ptr := a.&
        println( ptr.* )

        let x := if { a < 50 => 50 }

        match x using z {
                s32 => print(z)
                :none => println("none")
        }
}
