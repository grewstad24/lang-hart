import { .print, .heap }

# example program
fn main() -> :none {
      let my_array := ["hello", 1, true, :none]

      for my_array using elem {
            match elem using z {
                  :none => println("none")
                  else => println(z)
            }
      }

      print(:nl)

      @record (
            name := "bob"
            age := 50
            details := (
                  friend := "alice"
                  adult := true
            )
      ) ..print()

      let ptr := heap_new(type s32, 5)
      println(ptr.*)
      ptr.* := 7
      println(ptr.*)
}
