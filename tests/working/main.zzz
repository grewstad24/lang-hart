import { .print.pretty }

fn main() -> :none {
      @generalise {
            name := "bob"
            id := "bob123"
            userno := 12345
            status := :online
            details := {
                  adult := :true
                  friends := [ "alice", "john" ]
                  cookies := :none
                  address := (:error, :networkTimeOut)
            }
            premium := :false
      } ..pprint()
}
